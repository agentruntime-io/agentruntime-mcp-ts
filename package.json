{
  "name": "@agentruntime-labs/agentruntime-mcp",
  "version": "0.0.1",
  "description": "AgentRuntime MCP SDK (TypeScript) - Opinionated SDK for building MCP agents with FastMCP",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
